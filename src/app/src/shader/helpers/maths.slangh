#include "commontypes.h"

// TODO - define column/row major so is always consistent

// Some help from AI for the quaternion stuff
float4 quaternionFromAxisAngle(float3 axis, float angle)
{
    float halfAngle = angle * 0.5;

    return float4(normalize(axis) * sin(halfAngle), cos(halfAngle));
}

float4 quaternionMultiply(float4 a, float4 b)
{
    return float4(
        a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    );
}

float4x4 calculateModelMatrix(float4 transform, float4 rotation, float4 scale)
{
    float cosX = cos(rotation.x);
    float cosY = cos(rotation.y);
    float cosZ = cos(rotation.z);

    float sinX = sin(rotation.x);
    float sinY = sin(rotation.y);
    float sinZ = sin(rotation.z);

    return float4x4(
        // row1
        scale.x * (cosY * cosZ), scale.y * (cosY * sinZ), scale.z * (-sinY),
        transform.x,
        // row 2
        scale.x * (sinX * sinY * cosZ - cosX * sinZ),
        scale.y * (sinX * sinY * sinZ + cosX * cosZ), scale.z * (sinX * cosY),
        transform.y,
        // row 3
        scale.x * (cosX * sinY * cosZ + sinX * sinZ),
        scale.y * (cosX * sinY * sinZ - sinX * cosZ), scale.z * (cosX * cosY),
        transform.z,
        // row 4
        0.0, 0.0, 0.0, 1.0
    );
}

float4 calculateInstanceBoundingSphere(
    float4x4 modelMatrix, float4 minMeshBounds, float4 maxMeshBounds
)
{
    float4 instanceBoundsMinWS = mul(modelMatrix, minMeshBounds);
    float4 instanceBoundsMaxWS = mul(modelMatrix, maxMeshBounds);
    float4 centre = (instanceBoundsMinWS + instanceBoundsMaxWS) / 2.f;
    float3 extent = (instanceBoundsMaxWS - instanceBoundsMinWS).xyz / 2.f;
    float radius = length(extent);
    return float4(centre.xyz, radius);
}

float pointPlaneDistance(float4 testPoint, float4 planeEquation)
{
    return dot(testPoint.xyz, planeEquation.xyz) + planeEquation.w;
}

float4 rotatePositionAboutOriginOnXZPlane(float4 position, float angle)
{
    float cosAngle = cos(angle);
    float sinAngle = sin(angle);
    float newX = position.x;
    float newZ = position.z;
    position.x = newX * cosAngle - newZ * sinAngle;
    position.z = newX * sinAngle + newZ * cosAngle;
    return position;
}
